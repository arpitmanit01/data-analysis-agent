# ---------------------------------------------------------------------------
# LLM configuration (Azure AI Foundry via OpenAI-compatible endpoint)
# Copy this file to `.env` and fill in your key:  cp .env.example .env
# ---------------------------------------------------------------------------

# Required: your Azure AI Foundry API key
AZURE_AI_API_KEY=your-azure-ai-foundry-key-here

# OpenAI-compatible base URL for the Foundry "models" route
DAA_LLM_BASE_URL=https://vermaarpit-aifoundry1-s.cognitiveservices.azure.com/models

# Model deployment name
DAA_LLM_MODEL=gpt-5.4

# Sampling temperature (lower = more deterministic analysis code)
DAA_LLM_TEMPERATURE=0.1

# Per-request timeout (seconds) and max retry attempts on transient failures
DAA_LLM_TIMEOUT=60
DAA_LLM_MAX_RETRIES=3

# Guardrail: max input tokens allowed for a single LLM call before truncation
DAA_MAX_INPUT_TOKENS=100000

# Guardrail: seconds allowed for a single generated-code execution
DAA_CODE_TIMEOUT=30

# Directory where the SQLite conversation-memory checkpointer is stored
DAA_MEMORY_DB=.agent_memory.sqlite3

# Directory where generated plots/artifacts are written
DAA_ARTIFACTS_DIR=artifacts
